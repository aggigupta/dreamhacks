# Shopyland / ShopSense AI Environment Variables

# The prediction endpoints run fully WITHOUT any of these set — the deterministic
# engine is always the baseline. A key only unlocks LLM re-ranking + the
# sustainability nudge.
OPENAI_API_KEY=

# Optional model selection (defaults to gpt-4o-mini if not specified)
OPENAI_MODEL=gpt-4o-mini

# Optional OpenAI-compatible Base URL (for Groq, Together, OpenRouter, Ollama, etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Supabase (live database) -----------------------------------------------
# The app falls back to an in-process store when these are unset (CI / offline).
# Get these from your Supabase project → Settings → API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
